# Gruvbox Light, built into nevis. Copy it to ~/.config/nevis/themes/ to change it.

name = Gruvbox Light

background = #fbf1c7
foreground = #3c3836
surface    = #f2e5bc
accent     = #af3a03
comment    = #928374
red        = #9d0006
orange     = #af3a03
yellow     = #b57614
green      = #79740e
cyan       = #427b58
blue       = #076678
purple     = #8f3f71
