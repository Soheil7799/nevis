# One Dark, built into nevis. Copy it to ~/.config/nevis/themes/ to change it.

name = One Dark

background = #282c34
foreground = #abb2bf
surface    = #21252b
accent     = #61afef
comment    = #5c6370
red        = #e06c75
orange     = #d19a66
yellow     = #e5c07b
green      = #98c379
cyan       = #56b6c2
blue       = #61afef
purple     = #c678dd
