# Everforest, built into nevis. Copy it to ~/.config/nevis/themes/ to change it.

name = Everforest

background = #2d353b
foreground = #d3c6aa
surface    = #343f44
accent     = #a7c080
comment    = #859289
red        = #e67e80
orange     = #e69875
yellow     = #dbbc7f
green      = #a7c080
cyan       = #83c092
blue       = #7fbbb3
purple     = #d699b6
