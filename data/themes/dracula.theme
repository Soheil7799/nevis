# Dracula, built into nevis. Copy it to ~/.config/nevis/themes/ to change it.

name = Dracula

background = #282a36
foreground = #f8f8f2
surface    = #21222c
accent     = #bd93f9
comment    = #6272a4
red        = #ff5555
orange     = #ffb86c
yellow     = #f1fa8c
green      = #50fa7b
cyan       = #8be9fd
blue       = #8be9fd
purple     = #ff79c6
