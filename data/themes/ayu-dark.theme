# Ayu Dark, built into nevis. Copy it to ~/.config/nevis/themes/ to change it.

name = Ayu Dark

background = #0d1017
foreground = #bfbdb6
surface    = #0b0e14
accent     = #e6b450
comment    = #636a72
red        = #f07178
orange     = #ff8f40
yellow     = #ffb454
green      = #aad94c
cyan       = #95e6cb
blue       = #59c2ff
purple     = #d2a6ff
