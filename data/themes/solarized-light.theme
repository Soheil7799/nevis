# Solarized Light, built into nevis. Copy it to ~/.config/nevis/themes/ to change it.

name = Solarized Light

background = #fdf6e3
foreground = #657b83
surface    = #eee8d5
accent     = #b58900
comment    = #93a1a1
red        = #dc322f
orange     = #cb4b16
yellow     = #b58900
green      = #859900
cyan       = #2aa198
blue       = #268bd2
purple     = #6c71c4
